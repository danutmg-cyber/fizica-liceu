  "generalCompetencies": {
    "CG1": "Investigare științifică bazată pe dovezi",
    "CG2": "Explicarea fenomenelor fizice și transferul în contexte reale",
    "CG3": "Rezolvarea problemelor și a situațiilor-problemă",
    "CG4": "Comunicarea informațiilor și concluziilor științifice",
    "CG5": "Evaluarea impactului științei și tehnologiei"
  },

  "specificCompetencies": {
    "IX.CS.1.1": "Explorează fenomene și formulează observații și întrebări investigabile.",
    "IX.CS.1.2": "Proiectează investigații experimentale simple pentru testarea ipotezelor.",
    "IX.CS.1.3": "Realizează experimente și colectează și organizează date.",
    "IX.CS.1.4": "Prelucrează date experimentale și formulează concluzii susținute de dovezi.",

    "IX.CS.2.1": "Identifică relații cauzale și condiții de producere a fenomenelor.",
    "IX.CS.2.2": "Aplică legi și principii fizice pentru descrierea fenomenelor.",
    "IX.CS.2.3": "Utilizează reprezentări calitative și cantitative ale fenomenelor.",
    "IX.CS.2.4": "Corelează fenomenele studiate cu evenimente și situații reale.",

    "IX.CS.3.1": "Identifică datele și condițiile relevante ale unei probleme.",
    "IX.CS.3.2": "Folosește scheme, tabele și grafice pentru organizarea datelor unei probleme.",
    "IX.CS.3.3": "Aplică principii, legi și teoreme pentru rezolvarea problemelor.",
    "IX.CS.3.4": "Analizează și validează rezultatele obținute.",

    "IX.CS.4.1": "Utilizează corect limbajul fizicii, simbolurile și convențiile internaționale.",
    "IX.CS.4.2": "Reprezintă date experimentale prin tabele și grafice.",
    "IX.CS.4.3": "Redactează rapoarte simple de laborator.",
    "IX.CS.4.4": "Prezintă oral sau în scris raționamente și soluții.",

    "IX.CS.5.1": "Identifică aplicații ale științei și tehnologiei și efectele acestora.",
    "IX.CS.5.2": "Analizează responsabilitatea individuală și colectivă asociată utilizării științei și tehnologiei."
  },

